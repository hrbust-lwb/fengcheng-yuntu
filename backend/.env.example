PROJECT_NAME="凤城云图 (Fengcheng-Yuntu)"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174","http://localhost:5175","http://127.0.0.1:5175"]
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
LLM_MODEL_NAME="deepseek-chat"

AMAP_WEB_KEY="your-amap-web-key-here"
ENABLE_AMAP_ENRICHMENT=true
AMAP_TIMEOUT_SECONDS=15
DATABASE_URL="sqlite:///./fengcheng.db"
ENABLE_REDIS_CACHE=false

# Hybrid RAG: FAISS + BM25 + BGE-Reranker
FAISS_INDEX_DIR="./data/faiss_index"
EMBEDDING_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"
RERANKER_MODEL_NAME="BAAI/bge-reranker-base"
ENABLE_RERANKER=true

# Docker sandbox for tool execution
ENABLE_DOCKER_SANDBOX=false
TOOL_SANDBOX_IMAGE="fengcheng-tool-sandbox:latest"

LANGFUSE_SECRET_KEY="sk-lf"
LANGFUSE_PUBLIC_KEY="pk-lf"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
